# Dashboard listens independently; it never creates or replaces a Minecraft volume.
DASHBOARD_LISTEN=:8080
# Read-only integration locations (leave blank until known)
MINECRAFT_HOST=
MINECRAFT_LOG_PATH=
MINECRAFT_WORLD_PATH=
# Private RCON only: never publish this port. Values belong in an uncommitted .env.
RCON_ADDRESS=
RCON_PASSWORD=
# Explicitly opt in to constrained management capabilities.
MINECRAFT_CONTAINER_NAME=
DASHBOARD_BACKUP_PATH=
SESSION_SECRET=replace-with-a-long-random-secret
