# Dashboard listens independently; it never creates or replaces a Minecraft volume.
DASHBOARD_LISTEN=:8080
# Read-only integration locations (leave blank until known)
MINECRAFT_HOST=
MINECRAFT_LOG_PATH=
MINECRAFT_LOG_DIRECTORY=
MINECRAFT_WORLD_PATH=
MINECRAFT_PROPERTIES_PATH=
# Optional live player sources. Both files are mounted read-only; UUIDs and coordinates are never exposed by the dashboard.
MINECRAFT_USERCACHE_PATH=
MINECRAFT_OPS_PATH=
# Private RCON only: never publish this port. Values belong in an uncommitted .env.
RCON_ADDRESS=
RCON_PASSWORD=
# Explicitly opt in to constrained management capabilities.
MINECRAFT_CONTAINER_NAME=
DASHBOARD_BACKUP_PATH=
# Required dashboard access secret. Generate a long random value; this is entered in the local access screen.
SESSION_SECRET=replace-with-a-long-random-secret
