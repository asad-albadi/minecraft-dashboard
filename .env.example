# All paths are opt-in. Never commit the populated .env.
DASHBOARD_LISTEN=:8080
DASHBOARD_SERVER_NAME=Minecraft Server
MINECRAFT_HOST=
MINECRAFT_PORT=25565
# Existing private network; never change the Minecraft container network.
MINECRAFT_NETWORK=minecraft_default
MINECRAFT_LOG_PATH=
MINECRAFT_LOG_DIRECTORY=
MINECRAFT_WORLD_PATH=
MINECRAFT_PROPERTIES_PATH=
MINECRAFT_USERCACHE_PATH=
MINECRAFT_OPS_PATH=
RCON_ADDRESS=
RCON_PASSWORD=
MINECRAFT_CONTAINER_NAME=
# Container path, with an explicitly added read-only backup source mount.
DASHBOARD_BACKUP_PATH=
# Private named-account JSON on host (0600/0400), generated by setup-accounts.
DASHBOARD_ACCOUNTS_SOURCE=
# Dashboard-only directory; must not overlap Minecraft/backup/account sources.
DASHBOARD_DATA_SOURCE=
DASHBOARD_UID=65532
DASHBOARD_GID=65532
# Signing secret, at least 32 bytes, NOT a login password.
SESSION_SECRET=
# Local HTTP only. Set true and exact public origin for HTTPS deployments.
DASHBOARD_COOKIE_SECURE=false
DASHBOARD_PUBLIC_ORIGIN=
DASHBOARD_ENABLE_CHAT=false
DASHBOARD_ENABLE_CONSOLE=false
# Native go run configuration (Compose sets these container paths itself):
DASHBOARD_ACCOUNTS_FILE=
DASHBOARD_DATA_PATH=
